#!/usr/bin/osascript -l JavaScript
// 梅凝 Web App：冷启动后立刻投副屏并系统全屏，再关导览条。
// 依赖：辅助功能权限（小秘书.app / osascript）。
// 用法：osascript -l JavaScript place-secretary-webapp.jxa <webapp.path> [显示名] [Bundle ID]

ObjC.import("AppKit");

function run(argv) {
  const appPath = argv[0];
  const appName = argv[1] || "小秘书";
  const bundleId = argv[2] || "";
  if (!appPath) {
    console.log("secretary-launch: missing webapp path");
    return 1;
  }

  const se = Application("System Events");
  const host = Application.currentApplication();
  host.includeStandardAdditions = true;

  function round(n) {
    return Math.round(Number(n));
  }

  function screenCatalog() {
    const screens = $.NSScreen.screens;
    const count = Number(screens.count);
    const primary = $.NSScreen.mainScreen;
    const pf = primary.frame;
    const primaryMaxY = Number(pf.origin.y) + Number(pf.size.height);
    const list = [];
    for (let i = 0; i < count; i++) {
      const screen = screens.objectAtIndex(i);
      const frame = screen.frame;
      const x = Number(frame.origin.x);
      const w = Number(frame.size.width);
      const h = Number(frame.size.height);
      const axY = primaryMaxY - (Number(frame.origin.y) + h);
      list.push({
        index: i,
        isMain: Boolean(screen.isEqual(primary)),
        x: round(x),
        y: round(axY),
        w: round(w),
        h: round(h),
        area: w * h,
      });
    }
    return list;
  }

  function pickTarget(screens) {
    const primary = screens.find((s) => s.isMain) || screens[0];
    const externals = screens.filter((s) => !s.isMain).sort((a, b) => b.area - a.area);
    return externals[0] || primary;
  }

  function pointIn(cx, cy, r) {
    return cx >= r.x && cx < r.x + r.w && cy >= r.y && cy < r.y + r.h;
  }

  function isMeiningProcess(proc) {
    try {
      const bid = String(proc.bundleIdentifier());
      if (bundleId) return bid === bundleId;
      if (bid.indexOf("com.apple.Safari.WebApp") === 0) {
        try {
          return String(proc.name()) === appName;
        } catch (e) {
          return false;
        }
      }
    } catch (e) {}
    try {
      const name = String(proc.name());
      if (name === appName || name.indexOf("梅凝") >= 0) return true;
    } catch (e) {}
    return false;
  }

  function findProc() {
    const list = se.applicationProcesses();
    for (let i = 0; i < list.length; i++) {
      if (isMeiningProcess(list[i])) return list[i];
    }
    return null;
  }

  function contentWindow(proc) {
    if (!proc) return null;
    try {
      const wins = proc.windows();
      let best = null;
      let bestArea = 0;
      for (let i = 0; i < wins.length; i++) {
        try {
          const n = String(wins[i].name());
          if (n === "通用" || n === "隐私" || n === "扩展") continue;
          const size = wins[i].size();
          const w = Number(size[0]);
          const h = Number(size[1]);
          // Safari Web App 启动/切 Space 时会短暂暴露 33px 菜单条假窗。
          if (w < 400 || h < 300) continue;
          const area = w * h;
          if (area > bestArea) {
            best = wins[i];
            bestArea = area;
          }
        } catch (e) {}
      }
      return best;
    } catch (e) {}
    return null;
  }

  function refresh() {
    const proc = findProc();
    return { proc, win: contentWindow(proc) };
  }

  function attr(win, name) {
    try {
      const attrs = win.attributes();
      for (let i = 0; i < attrs.length; i++) {
        if (String(attrs[i].name()) === name) return attrs[i];
      }
    } catch (e) {}
    return null;
  }

  function readFS(win) {
    try {
      const a = attr(win, "AXFullScreen");
      return a ? Boolean(a.value()) : null;
    } catch (e) {
      return null;
    }
  }

  function setFS(win, on) {
    try {
      const a = attr(win, "AXFullScreen");
      if (!a) return false;
      a.value = !!on;
      return true;
    } catch (e) {
      return false;
    }
  }

  function setPosSize(win, x, y, w, h) {
    try {
      const pos = attr(win, "AXPosition");
      const size = attr(win, "AXSize");
      if (pos) pos.value = [x, y];
      if (size) size.value = [w, h];
    } catch (e) {}
    try {
      win.position = [x, y];
      win.size = [w, h];
    } catch (e) {}
  }

  function onTarget(win, target) {
    try {
      const pos = win.position();
      const size = win.size();
      return pointIn(pos[0] + size[0] / 2, pos[1] + size[1] / 2, target);
    } catch (e) {
      return false;
    }
  }

  function describe(win, target) {
    try {
      return `pos=${win.position()} size=${win.size()} fs=${readFS(win)} onTarget=${onTarget(win, target)}`;
    } catch (e) {
      return "describe-failed";
    }
  }

  function waitWindow(maxAttempts) {
    for (let i = 0; i < maxAttempts; i++) {
      delay(0.2);
      const cur = refresh();
      if (cur.win) return cur;
      // 只激活目标 Web App；绝不向当前前台应用误发全屏快捷键。
      if (cur.proc && (i === 3 || i === 15 || i === 30)) {
        try {
          cur.proc.frontmost = true;
        } catch (e) {}
      }
      if (i === 8 || i === 24) {
        try {
          host.doShellScript("open " + JSON.stringify(appPath));
        } catch (e) {}
      }
    }
    return refresh();
  }

  function enterFS(proc, win, target) {
    function okNow() {
      const cur = refresh();
      if (!cur.win) return false;
      if (!onTarget(cur.win, target)) return false;
      if (readFS(cur.win) === true) return true;
      // 有些时候 AXFullScreen 瞬时不准，用尺寸兜底
      try {
        const size = cur.win.size();
        return size[0] >= target.w - 8 && size[1] >= target.h - 40;
      } catch (e) {
        return false;
      }
    }

    if (okNow()) return "already";

    // 1) AX
    setFS(win, true);
    delay(0.9);
    if (okNow()) return "ax";

    // 2) 菜单
    try {
      proc.frontmost = true;
      delay(0.2);
      const items = proc.menuBars[0].menus.byName("显示").menuItems;
      for (let i = 0; i < items.length; i++) {
        const title = String(items[i].name());
        if (title.indexOf("进入全屏幕") >= 0) {
          items[i].click();
          delay(1.0);
          if (okNow()) return "menu";
          break;
        }
        // 已是全屏
        if (title.indexOf("退出全屏幕") >= 0) {
          if (okNow()) return "already-menu";
        }
      }
    } catch (e) {
      console.log("secretary-launch: menu fs failed " + e);
    }

    // 3) 快捷键（可能需点两次：先退出错误态再进入）
    try {
      proc.frontmost = true;
      delay(0.15);
      se.keystroke("f", { using: ["control down", "command down"] });
      delay(1.0);
      if (okNow()) return "hotkey";
      // 若仍非全屏，再按一次
      if (!okNow()) {
        se.keystroke("f", { using: ["control down", "command down"] });
        delay(1.0);
        if (okNow()) return "hotkey2";
      }
    } catch (e) {
      console.log("secretary-launch: hotkey fs failed " + e);
    }

    return null;
  }

  function disableNav(proc) {
    if (!proc) return;
    try {
      proc.frontmost = true;
      delay(0.15);
      proc.menuBars[0].menus.byName(appName).menuItems.byName("设置…").click();
      delay(0.8);
    } catch (e) {
      console.log("secretary-launch: settings open failed " + e);
      return;
    }
    try {
      const wins = proc.windows();
      for (let i = 0; i < wins.length; i++) {
        let isSettings = false;
        try {
          isSettings = String(wins[i].name()) === "通用";
        } catch (e) {}
        if (!isSettings) continue;
        const elems = wins[i].entireContents();
        for (let j = 0; j < elems.length; j++) {
          try {
            if (String(elems[j].role()) !== "AXCheckBox") continue;
            if (String(elems[j].name()) !== "显示导览控制") continue;
            if (Number(elems[j].value()) === 1) {
              elems[j].click();
              delay(0.25);
            }
            console.log("secretary-launch: nav_controls=" + elems[j].value());
          } catch (e) {}
        }
      }
    } catch (e) {}
    try {
      se.keystroke("w", { using: ["command down"] });
      delay(0.2);
    } catch (e) {}
  }

  const screens = screenCatalog();
  const target = pickTarget(screens);
  console.log(
    `secretary-launch screens=${screens.length} target=${target.index} isMain=${target.isMain} ${target.w}x${target.h}@${target.x},${target.y}`,
  );

  // 启动脚本应已冷启动；这里再 open 一次保底。
  host.doShellScript("open " + JSON.stringify(appPath));
  let { proc, win } = waitWindow(75);
  if (!win) {
    console.log(`secretary-launch: no valid content window bid=${bundleId || "unknown"} (ignored transient/menu windows)`);
    return 1;
  }
  console.log("secretary-launch: found " + describe(win, target));

  let confirmedFullscreen = false;
  let confirmedHow = null;
  for (let attempt = 1; attempt <= 4; attempt++) {
    ({ proc, win } = refresh());
    if (!win) {
      host.doShellScript("open " + JSON.stringify(appPath));
      ({ proc, win } = waitWindow(40));
    }
    if (!win) continue;

    if (readFS(win) === true && onTarget(win, target)) {
      console.log(`secretary-launch: already good attempt=${attempt}`);
      confirmedFullscreen = true;
      confirmedHow = "already";
      break;
    }

    if (readFS(win) === true) {
      setFS(win, false);
      delay(0.5);
      ({ proc, win } = waitWindow(15));
      if (!win) continue;
    }

    try {
      proc.frontmost = true;
    } catch (e) {}
    // 贴副屏
    setPosSize(win, target.x + 16, target.y + 16, Math.max(1000, target.w - 48), Math.max(700, target.h - 48));
    delay(0.4);
    ({ proc, win } = waitWindow(12));
    if (!win) continue;
    if (!onTarget(win, target)) {
      setPosSize(win, target.x + 40, target.y + 40, 1280, 800);
      delay(0.35);
      ({ proc, win } = waitWindow(10));
    }
    if (!win) continue;
    console.log(`secretary-launch: attempt=${attempt} after-move ${describe(win, target)}`);

    const how = enterFS(proc, win, target);
    delay(0.35);
    ({ proc, win } = waitWindow(12));
    console.log(`secretary-launch: attempt=${attempt} fullscreen=${how || false} ${win ? describe(win, target) : "no-win"}`);
    // enterFS 只在亲眼读到 AXFullScreen=true 且窗口中心位于目标屏时返回成功。
    // 全屏 Space 切换后 AX 可能立即把窗口隐藏；不能用随后的短暂 no-win 推翻已确认结果。
    if (how) {
      confirmedFullscreen = true;
      confirmedHow = how;
      break;
    }
  }

  ({ proc, win } = refresh());
  const ok = confirmedFullscreen || !!(win && onTarget(win, target) && readFS(win) === true);
  console.log(
    `secretary-launch: final ok=${ok} systemFullscreen=${ok} via=${confirmedHow || "final-read"} ${win ? describe(win, target) : "AX-hidden-after-space-switch"}`,
  );
  return ok ? 0 : 1;
}
