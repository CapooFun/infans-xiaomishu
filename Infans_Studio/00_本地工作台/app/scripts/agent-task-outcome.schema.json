{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "evidenceRefs", "nextStep", "nextReviewAt"],
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "blocked", "failed", "progress"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200
    },
    "evidenceRefs": {
      "type": "array",
      "maxItems": 24,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "nextStep": {
      "type": "string",
      "maxLength": 1200
    },
    "nextReviewAt": {
      "type": ["string", "null"]
    }
  }
}
