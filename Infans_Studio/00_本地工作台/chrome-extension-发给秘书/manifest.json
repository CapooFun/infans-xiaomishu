{
  "manifest_version": 3,
  "name": "一键发给秘书",
  "version": "1.1.5",
  "description": "右键一下，把本人主动选中的网页、链接、文字或公开图片网址发给秘书。",
  "minimum_chrome_version": "120",
  "permissions": [
    "activeTab",
    "alarms",
    "contextMenus",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/yingning-16.png",
    "32": "icons/yingning-32.png",
    "48": "icons/yingning-48.png",
    "128": "icons/yingning-128.png"
  },
  "action": {
    "default_title": "一键发给秘书",
    "default_icon": {
      "16": "icons/yingning-16.png",
      "32": "icons/yingning-32.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/yingning-128.png"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "options_page": "options.html"
}
